# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: server-only, never expose to the client.
# Required for admin-only operations (inviting members via Supabase Auth Admin API).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this deployment, used to build email confirmation / invite
# redirect links (e.g. http://localhost:3000 in dev, https://your-app.vercel.app in prod).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (error monitoring) - from the Sentry project settings
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.us.sentry.io/0
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_OTLP_TRACES_URL=https://o0.ingest.us.sentry.io/api/0/integration/otlp/v1/traces
SENTRY_PUBLIC_KEY=your-sentry-public-key
SENTRY_VERCEL_LOG_DRAIN_URL=https://o0.ingest.us.sentry.io/api/0/integration/vercel/logs/

# Discord webhook of the "cobranças" channel (Channel settings -> Integrations
# -> Webhooks). Server-only: anyone with this URL can post to the channel.
DISCORD_COBRANCA_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
# Same, for a Discord *forum* channel (each cobrança becomes a new post). Either or
# both of the two variables can be set; every configured one receives it.
DISCORD_COBRANCA_FORUM_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
# Optional: Discord mention that the "Marcar o supervisor" checkbox tags in the
# cobrança. A user is <@USER_ID>, a role is <@&ROLE_ID> (Discord: enable Developer
# Mode, right-click the user/role -> Copy ID).
DISCORD_COBRANCA_SUPERVISOR_MENTION=<@123456789012345678>

# Optional: Discord webhook that gets a heads-up for every new access request
# (name, e-mail, organization and a link to /plataforma, where it is approved).
DISCORD_ACCESS_REQUEST_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
