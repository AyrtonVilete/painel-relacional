# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: server-only, never expose to the client.
# Required for admin-only operations (inviting members via Supabase Auth Admin API).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this deployment, used to build email confirmation / invite
# redirect links (e.g. http://localhost:3000 in dev, https://your-app.vercel.app in prod).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
